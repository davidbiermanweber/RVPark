@{
    ViewData["Title"] = "Access Denied";
    var isStaff = ViewBag.IsStaff as bool? ?? false;
}

<div class="container mt-5" style="max-width: 560px;">
    <div class="card shadow-sm border-warning">
        <div class="card-body text-center p-4">
            <div class="display-4 mb-2">🔒</div>
            <h2 class="mb-3">Access Denied</h2>

            <p class="text-muted">
                You're signed in, but your account doesn't have permission to open this page.
            </p>

            @if (isStaff)
            {
                <p class="text-muted small">
                    Site and pricing administration is limited to administrator accounts
                    (access level 3). If you need access, ask an administrator to update
                    your account level.
                </p>
            }

            <div class="d-flex gap-2 justify-content-center mt-4">
                @if (isStaff)
                {
                    <a asp-controller="Account" asp-action="Dashboard" class="btn btn-primary">Back to Dashboard</a>
                    <a asp-controller="EmployeeReservation" asp-action="Index" class="btn btn-outline-secondary">Reservations</a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
                }
            </div>
        </div>
    </div>
</div>
