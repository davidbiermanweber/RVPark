@model RvParkApp.Models.Employee

<h2>Create Employee</h2>
<hr />

<form asp-action="CreateEmployee" method="post" class="mt-4">
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Name</label>
        <input asp-for="Name" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="EmployeeId" class="form-label">Employee ID</label>
        <input asp-for="EmployeeId" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="Username" class="form-label">Username</label>
        <input asp-for="Username" class="form-control" required />
    </div>
    <div class="mb-3">
        <label for="Password" class="form-label">Password</label>
        <input name="Password" type="password" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="AccessLevel" class="form-label">Access Level (1-3)</label>
        <input asp-for="AccessLevel" class="form-control" type="number" min="1" max="3" required />
    </div>

    <button type="submit" class="btn btn-success">Create Employee</button>
    <a asp-action="ManageEmployees" class="btn btn-secondary ms-2">Cancel</a>
</form>
