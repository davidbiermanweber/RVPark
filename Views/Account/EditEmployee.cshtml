@model RvParkApp.Models.Employee

<h2>Edit Employee</h2>
<hr />

<form asp-action="EditEmployee" method="post" class="mt-4">
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Name</label>
        <input asp-for="Name" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="EmployeeId" class="form-label">Employee ID</label>
        <input asp-for="EmployeeId" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="Username" class="form-label">Username</label>
        <input asp-for="Username" class="form-control" required />
    </div>
    <div class="mb-3">
        <label for="newPassword" class="form-label">New Password (leave blank to keep current)</label>
        <input name="newPassword" type="password" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="AccessLevel" class="form-label">Access Level (1-3)</label>
        <input asp-for="AccessLevel" class="form-control" type="number" min="1" max="3" required />
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsLocked" class="form-check-input" />
        <label asp-for="IsLocked" class="form-check-label">Lock this employee from logging in</label>
    </div>

    <button type="submit" class="btn btn-success">Save Changes</button>
    <a asp-action="ManageEmployees" class="btn btn-secondary ms-2">Cancel</a>
</form>
