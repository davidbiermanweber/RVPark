@{
    // Retrieve the Access Level from the user's signed-in cookie claims
    var accessLevelStr = User.FindFirst("AccessLevel")?.Value;
    int accessLevel = 0;
    int.TryParse(accessLevelStr, out accessLevel);

    var userName = User.FindFirst("Name")?.Value ?? "there";
    var isAdmin = accessLevel == 3;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">
                        <div>
                            <h2 class="mb-1">Dashboard</h2>
                            <p class="text-muted mb-0">Welcome back, @userName.</p>
                        </div>
                        <span class="badge bg-@(isAdmin ? "warning text-dark" : "primary") px-3 py-2 mt-2 mt-md-0">
                            Access Level @accessLevel
                        </span>
                    </div>

                    <hr />

                    @if (isAdmin)
                    {
                        <div class="alert alert-warning" role="alert">
                            <strong>Administrator access enabled.</strong> Use the shortcuts below to manage the campground operations.
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <a asp-action="ManageEmployees" class="btn btn-warning w-100">Manage Employees</a>
                            </div>
                            <div class="col-md-6">
                                <a asp-controller="Sites" asp-action="ManageReservations" class="btn btn-outline-primary w-100">Manage Reservations</a>
                            </div>
                            <div class="col-md-6">
                                <a asp-controller="Sites" asp-action="Index" class="btn btn-outline-secondary w-100">Manage Sites</a>
                            </div>
                            <div class="col-md-6">
                                <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-success w-100">Manage Categories</a>
                            </div>
                            <div class="col-md-6">
                                <a asp-controller="Fee" asp-action="Index" class="btn btn-outline-info w-100">Manage Fees</a>
                            </div>
                            <div class="col-md-6">
                                <a asp-controller="ParkPolicy" asp-action="Edit" class="btn btn-outline-dark w-100">Manage Policies</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            Your account is set up with the current access level shown above.
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Need to sign out? Use the button below.</span>
                        <form asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-danger">Log Out</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>