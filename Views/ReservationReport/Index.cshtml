@model RvParkApp.Models.ReservationReportViewModel

@{
    ViewData["Title"] = "Reservation Report";
}

<h2 class="mb-4">Reservation Report</h2>

<form asp-action="Index" method="post" class="mb-4">
    <div class="card p-3 shadow-sm">

        <div class="row">

            <div class="col-md-4">
                <label class="form-label">Start Date</label>
                <input type="date"
                       name="startDate"
                       class="form-control"
                       required />
            </div>

            <div class="col-md-4">
                <label class="form-label">End Date</label>
                <input type="date"
                       name="endDate"
                       class="form-control"
                       required />
            </div>

            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary">
                    Generate Report
                </button>
            </div>

        </div>

    </div>
</form>

@if (Model != null &&
    Model.StartDate != DateTime.MinValue &&
    Model.EndDate != DateTime.MinValue)
{
    <div class="mt-3 mb-4">
        <h5>Report Details</h5>

        <p>
            <strong>Report Period:</strong>
            @Model.StartDate.ToShortDateString() -
            @Model.EndDate.ToShortDateString()
        </p>

        <p>
            <strong>Generated:</strong>
            @DateTime.Now.ToString("MMMM dd, yyyy h:mm tt")
        </p>
    </div>
}
@if (Model != null)
{
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm text-center border-primary">
                <div class="card-body">
                    <h6>Total Reservations</h6>
                    <h3>@(Model.Completed.Count + Model.InProgress.Count + Model.Upcoming.Count)</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm text-center border-success">
                <div class="card-body">
                    <h6>Revenue</h6>
                    <h3>$@Model.TotalRevenue.ToString("N2")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm text-center border-warning">
                <div class="card-body">
                    <h6>Occupied Sites</h6>
                    <h3>@Model.OccupiedSites / @Model.TotalSites</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm text-center border-info">
                <div class="card-body">
                    <h6>Occupancy</h6>
                    <h3>@Model.OccupancyRate.ToString("0")%</h3>
                </div>
            </div>
        </div>

    </div>


<!-- Reservation Summary -->

<div class="row mb-4">

    <div class="col-md-4">
        <div class="card shadow-sm text-center border-success">
            <div class="card-body">
                <h6>Completed</h6>
                <h3>@Model.Completed.Count</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm text-center border-primary">
            <div class="card-body">
                <h6>In Progress</h6>
                <h3>@Model.InProgress.Count</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm text-center border-info">
            <div class="card-body">
                <h6>Upcoming</h6>
                <h3>@Model.Upcoming.Count</h3>
            </div>
        </div>
    </div>

</div>

<h3 class="mt-4">Completed Reservations</h3>

    @if (Model.Completed.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Start</th>
                        <th>Finish</th>
                        <th>Total Cost</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var reservation in Model.Completed)
                    {
                        <tr>
                            <td>@reservation.User?.Name</td>
                            <td>@reservation.User?.Email</td>
                            <td>@reservation.User?.Phone</td>
                            <td>
                                @if (reservation.ReservationStatus == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (reservation.ReservationStatus == "Cancelled")
                                {
                                    <span class="badge bg-danger">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">
                                        @reservation.ReservationStatus
                                    </span>
                                }
                            </td>
                            <td>@reservation.StartDate.ToShortDateString()</td>
                            <td>@reservation.FinishDate.ToShortDateString()</td>
                            <td>$@reservation.TotalCost.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">No completed reservations found.</p>
    }



    <h3 class="mt-4">Reservations In Progress</h3>

    @if (Model.InProgress.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Start</th>
                        <th>Finish</th>
                        <th>Total Cost</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var reservation in Model.InProgress)
                    {
                        <tr>
                            <td>@reservation.User?.Name</td>
                            <td>@reservation.User?.Email</td>
                            <td>@reservation.User?.Phone</td>
                            <td>
                                @if (reservation.ReservationStatus == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (reservation.ReservationStatus == "Cancelled")
                                {
                                    <span class="badge bg-danger">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">
                                        @reservation.ReservationStatus
                                    </span>
                                }
                            </td>
                            <td>@reservation.StartDate.ToShortDateString()</td>
                            <td>@reservation.FinishDate.ToShortDateString()</td>
                            <td>$@reservation.TotalCost.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">No reservations currently in progress.</p>
    }



    <h3 class="mt-4">Upcoming Reservations</h3>

    @if (Model.Upcoming.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Start</th>
                        <th>Finish</th>
                        <th>Total Cost</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var reservation in Model.Upcoming)
                    {
                        <tr>
                            <td>@reservation.User?.Name</td>
                            <td>@reservation.User?.Email</td>
                            <td>@reservation.User?.Phone</td>
                            <td>
                                @if (reservation.ReservationStatus == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (reservation.ReservationStatus == "Cancelled")
                                {
                                    <span class="badge bg-danger">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">
                                        @reservation.ReservationStatus
                                    </span>
                                }
                            </td>
                            <td>@reservation.StartDate.ToShortDateString()</td>
                            <td>@reservation.FinishDate.ToShortDateString()</td>
                            <td>$@reservation.TotalCost.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">No upcoming reservations found.</p>
    }
}
<hr class="my-5" />

<h3>Today's Arrivals</h3>

@if (Model?.ArrivalsToday?.Any() == true)
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">

            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Arrival Date</th>
                </tr>
            </thead>

            <tbody>

            @foreach (var reservation in Model.ArrivalsToday)
            {
                <tr>
                    <td>@reservation.User?.Name</td>
                    <td>@reservation.User?.Email</td>
                    <td>@reservation.User?.Phone</td>
                    <td>@reservation.StartDate.ToShortDateString()</td>
                </tr>
            }

            </tbody>

        </table>
    </div>
}
else
{
    <p class="text-muted">No arrivals scheduled today.</p>
}
<hr class="my-5" />

<h3>Today's Departures</h3>

@if (Model?.DeparturesToday?.Any() == true)
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">

            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Departure Date</th>
                </tr>
            </thead>

            <tbody>

            @foreach (var reservation in Model.DeparturesToday)
            {
                <tr>
                    <td>@reservation.User?.Name</td>
                    <td>@reservation.User?.Email</td>
                    <td>@reservation.User?.Phone</td>
                    <td>@reservation.FinishDate.ToShortDateString()</td>
                </tr>
            }

            </tbody>

        </table>
    </div>
}
else
{
    <p class="text-muted">No departures scheduled today.</p>
}
