@model List<Reservation>
@{
    ViewData["Title"] = "My Reservations";
}

<h2>📋 My Reservations</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info mt-3">
        You don't have any reservations yet.
        <a asp-controller="CustomerBooking" asp-action="Search">Find an available site</a> to get started.
    </div>
}
else
{
    <!-- SEARCH AND FILTER BAR -->
    <div class="row mb-4 mt-3">
        <div class="col-md-6 mb-2 mb-md-0">
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white">🔍</span>
                <input type="text" id="searchName" class="form-control border-start-0" placeholder="Search by site name..." />
            </div>
        </div>
        <div class="col-md-6">
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white">📅 Filter by Date</span>
                <input type="date" id="searchDate" class="form-control" />
                <button class="btn btn-outline-secondary" type="button" id="clearFilters">Clear</button>
            </div>
        </div>
    </div>
    <!-- END SEARCH AND FILTER BAR -->

    <div class="row row-cols-1 row-cols-md-2 g-3 mt-1" id="reservationsContainer">
        @foreach (var r in Model)
        {
            var nights = Math.Max(1, (r.FinishDate - r.StartDate).Days);
            var isCancelled = r.ReservationStatus != null && r.ReservationStatus.StartsWith("Cancel");
            var siteName = r.Site != null ? r.Site.Name : "Site to be assigned";

            <!-- Added data-attributes and a targeting class for JS filtering -->
            <div class="col reservation-card-wrapper" 
                 data-site-name="@siteName.ToLower()" 
                 data-start-date="@r.StartDate.ToString("yyyy-MM-dd")" 
                 data-finish-date="@r.FinishDate.ToString("yyyy-MM-dd")">
                
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title mb-1">
                                    @(r.Site != null ? $"⛺ {r.Site.Name}" : "⛺ Site to be assigned")
                                </h5>
                                <span class="badge @(isCancelled ? "bg-secondary" : "bg-success")">
                                    @r.ReservationStatus
                                </span>
                            </div>
                            @if (r.Site?.Category != null)
                            {
                                <div class="text-muted small">@r.Site.Category.Name</div>
                            }
                            <div class="mt-2">
                                <strong>@r.StartDate.ToString("MMM d, yyyy")</strong> →
                                <strong>@r.FinishDate.ToString("MMM d, yyyy")</strong>
                                <span class="text-muted">(@nights night@(nights == 1 ? "" : "s"))</span>
                            </div>
                            <div class="mt-2 small text-muted">
                                <span>👤 @r.NumberOfAdults adult@(r.NumberOfAdults == 1 ? "" : "s")</span>
                                @if (r.NumberOfChildren > 0)
                                {
                                    <span class="ms-2">🧒 @r.NumberOfChildren child@(r.NumberOfChildren == 1 ? "" : "ren")</span>
                                }
                                @if (r.HasPets)
                                {
                                    <span class="ms-2">🐾 Pets</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(r.SpecialRequests))
                            {
                                <div class="mt-1 small text-muted fst-italic">📝 @r.SpecialRequests</div>
                            }
                            <table class="table table-sm mt-2 mb-0">
                                <tbody>
                                    <tr>
                                        <td>Nightly rate</td>
                                        <td class="text-end">@r.DailyRate.ToString("C")</td>
                                    </tr>
                                    @foreach (var rf in r.ReservationFees ?? Enumerable.Empty<ReservationFee>())
                                    {
                                        <tr>
                                            <td>@(rf.Fee?.Name ?? "Fee")</td>
                                            <td class="text-end">@rf.AppliedAmount.ToString("C")</td>
                                        </tr>
                                    }
                                    @if (r.RefundedAmount > 0)
                                    {
                                        <tr class="text-danger">
                                            <td>Refunded</td>
                                            <td class="text-end">-@r.RefundedAmount.ToString("C")</td>
                                        </tr>
                                    }
                                    <tr class="fw-bold border-top">
                                        <td>Total</td>
                                        <td class="text-end">@r.TotalCost.ToString("C")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        @if (!isCancelled)
                        {
                            <div class="mt-3 pt-2 border-top">
                                @if (!string.Equals(r.ReservationStatus, "Completed", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="mb-2">
                                        @if (!string.IsNullOrWhiteSpace(r.Notes))
                                        {
                                            <div class="small text-muted">Notes: @r.Notes</div>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-info w-100 mt-1" data-bs-toggle="modal" data-bs-target="#notesModal-@r.Id">
                                            📝 Add / Update Notes
                                        </button>
                                    </div>
                                }

                                <div class="d-flex gap-1 justify-content-between">
                                    <button type="button" class="btn btn-sm btn-outline-secondary flex-grow-1" data-bs-toggle="modal" data-bs-target="#editModal-@r.Id">
                                        ⚙️ Modify
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-primary flex-grow-1" data-bs-toggle="modal" data-bs-target="#payModal-@r.Id">
                                        💵 Pay Cash/Check
                                    </button>
                                    <button type="button" class="btn btn-sm btn-success flex-grow-1"
                                            data-res-id="@r.Id"
                                            data-amount="@r.TotalCost"
                                            data-user-id="@r.UserId"
                                            data-site-id="@(r.Site?.Id ?? 0)"
                                            data-checkin="@r.StartDate.ToString("yyyy-MM-dd")"
                                            data-checkout="@r.FinishDate.ToString("yyyy-MM-dd")"
                                            data-bs-toggle="modal" data-bs-target="#stripeModal-@r.Id">
                                        💳 Pay via Credit Card
                                    </button>
                                    <form asp-controller="CustomerBooking" asp-action="Cancel" asp-route-id="@r.Id" method="post" class="d-inline flex-grow-1" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">❌ Cancel</button>
                                    </form>
                                </div>
                            </div>

                            <div class="modal fade" id="notesModal-@r.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <form asp-controller="CustomerAccount" asp-action="SaveReservationNotes" asp-route-id="@r.Id" method="post" class="modal-content text-start">
                                        @Html.AntiForgeryToken()
                                        <div class="modal-header">
                                            <h5 class="modal-title">Reservation Notes</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <label class="form-label fw-bold">Notes for this stay</label>
                                            <textarea name="notes" class="form-control" rows="4" placeholder="Add any details the staff should know about this reservation">@r.Notes</textarea>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            <button type="submit" class="btn btn-primary">Save Notes</button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            @* POPUP MODAL: DATE SELECTION & FRESH VALIDATION EDITING *@
                            <div class="modal fade" id="editModal-@r.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <form asp-controller="CustomerBooking" asp-action="Edit" asp-route-id="@r.Id" method="post" class="modal-content text-start">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Change Stay Dates</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p class="text-muted small">Altering these parameters performs a fresh schedule validation. Extended balances calculate automatically.</p>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Arrival Date</label>
                                                <input type="date" name="newStart" class="form-control" value="@r.StartDate.ToString("yyyy-MM-dd")" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Departure Date</label>
                                                <input type="date" name="newFinish" class="form-control" value="@r.FinishDate.ToString("yyyy-MM-dd")" required />
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            <button type="submit" class="btn btn-primary">Recalculate & Save</button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            @* POPUP MODAL: ALTERNATIVE PAYMENT RECORDING SYSTEM *@
                            <div class="modal fade" id="payModal-@r.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <form asp-controller="CustomerBooking" asp-action="PayAlternative" asp-route-id="@r.Id" method="post" class="modal-content text-start">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Record Alternative Payment Method</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Method Selector</label>
                                                <select name="method" class="form-select">
                                                    <option value="Cash">Cash Account Ledger</option>
                                                    <option value="Check">Physical Check Routing</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Transaction Reference Tracking Tokens</label>
                                                <input type="text" name="refNumber" class="form-control" placeholder="Enter Check No. or Cash Receipt Slip Identifier" />
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            <button type="submit" class="btn btn-success">Record Transaction</button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            @* POPUP MODAL: STRIPE CREDIT CARD PAYMENT *@
                            <div class="modal fade" id="stripeModal-@r.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">💳 Pay via Credit Card</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p class="mb-1"><strong>Amount:</strong> @r.TotalCost.ToString("C")</p>
                                            <p class="mb-3"><strong>Stay:</strong> @r.StartDate.ToString("MMM d") → @r.FinishDate.ToString("MMM d, yyyy")</p>
                                            <div id="card-element-@r.Id" class="form-control p-2 mb-2"></div>
                                            <div id="card-error-@r.Id" class="text-danger small"></div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="button" class="btn btn-success"
                                                    onclick="payWithCard(@r.Id, @r.TotalCost, @r.UserId, @(r.Site?.Id ?? 0), '@r.StartDate.ToString("yyyy-MM-dd")', '@r.FinishDate.ToString("yyyy-MM-dd")', @r.Id)">
                                                Confirm Payment
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @section Scripts {
        <script src="https://js.stripe.com/v3/"></script>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const searchName = document.getElementById("searchName");
                const searchDate = document.getElementById("searchDate");
                const clearFilters = document.getElementById("clearFilters");
                const cards = document.querySelectorAll(".reservation-card-wrapper");

                function filterCards() {
                    const nameQuery = searchName.value.toLowerCase().trim();
                    const dateQuery = searchDate.value;

                    cards.forEach(card => {
                        const siteName = card.getAttribute("data-site-name");
                        const startDate = card.getAttribute("data-start-date");
                        const finishDate = card.getAttribute("data-finish-date");

                        const matchesName = nameQuery === "" || siteName.includes(nameQuery);

                        let matchesDate = true;
                        if (dateQuery !== "") {
                            matchesDate = (dateQuery >= startDate && dateQuery <= finishDate);
                        }

                        card.style.display = (matchesName && matchesDate) ? "" : "none";
                    });
                }

                searchName.addEventListener("input", filterCards);
                searchDate.addEventListener("change", filterCards);
                clearFilters.addEventListener("click", function () {
                    searchName.value = "";
                    searchDate.value = "";
                    filterCards();
                });

                const stripe = Stripe('@ViewBag.PublishableKey');
                const cardElements = {};

                document.querySelectorAll('[data-res-id]').forEach(btn => {
                    const resId = btn.getAttribute('data-res-id');
                    const modalEl = document.getElementById('stripeModal-' + resId);
                    if (!modalEl) return;
                    modalEl.addEventListener('shown.bs.modal', () => {
                        if (!cardElements[resId]) {
                            const elements = stripe.elements();
                            cardElements[resId] = elements.create('card', { style: { base: { fontSize: '16px' } } });
                            cardElements[resId].mount('#card-element-' + resId);
                        }
                    });
                });

                window.payWithCard = async function(resId, amount, userId, siteId, checkIn, checkOut, resDbId) {
                    const errorEl = document.getElementById('card-error-' + resId);
                    errorEl.textContent = '';

                    const intentRes = await fetch('/Payment/CreatePaymentIntent', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ amount })
                    });
                    const { clientSecret } = await intentRes.json();

                    const { paymentIntent, error } = await stripe.confirmCardPayment(clientSecret, {
                        payment_method: { card: cardElements[resId] }
                    });

                    if (error) {
                        errorEl.textContent = error.message;
                        return;
                    }

                    await fetch('/Payment/SaveOrder', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            customerId: userId,
                            siteId: siteId,
                            checkIn: checkIn,
                            checkOut: checkOut,
                            notes: '',
                            amount: amount,
                            paymentToken: paymentIntent.id,
                            paymentMethod: 'Credit Card',
                            customerEmail: '',
                            reservationId: resDbId
                        })
                    });

                    window.location.href = '/Payment/Success';
                };
            });
        </script>
    }
}